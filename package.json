{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ATLAS \u2014 Architecture Traceability and Lossiness Analysis System",
  "author": "Aous Abdo",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-no-real-data.mjs && tsc --noEmit && vite build && node scripts/check-offline.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/seed-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots=all",
    "falsify": "node scripts/falsify.mjs",
    "ingest:tables": "python3 -c \"import sys; sys.path.insert(0,'ingest/src'); from atlas_ingest.bundle import emit_classifier_module; emit_classifier_module('src/data/generated/classifierTables.ts')\"",
    "check:offline": "node scripts/check-offline.mjs dist",
    "make:sample-workbook": "node scripts/make-sample-workbook.mjs",
    "check:data": "node scripts/check-no-real-data.mjs",
    "test:data": "node --test scripts/__tests__/no-real-data.test.mjs",
    "build:standalone": "ATLAS_STANDALONE=1 vite build && node scripts/build-singlefile.mjs dist-standalone-build",
    "test:standalone": "node --test scripts/__tests__/singlefile.test.mjs",
    "e2e:standalone": "playwright test --config playwright.standalone.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.2",
    "d3": "7.8.5",
    "d3-sankey": "^0.12.3",
    "html2canvas-pro": "^2.3.3",
    "jspdf": "4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
